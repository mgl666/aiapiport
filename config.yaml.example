# aiapiport 配置示例。复制为 config.yaml 后填入你自己的 key。

# 网关自身:监听地址 + 鉴权 key(客户端必须带这个 key)
server:
  listen: ":8787"
  auth_key: "sk-gateway-change-me"

# 网页管理面板(可选)。配置 listen 后启动独立管理端口,用上面的 auth_key 登录,
# 在网页里直接改服务商/路由并保存,网关约 1 秒内热重载生效,无需重启。
# 不配置或留空则不启动管理面板。
admin:
  listen: ":4001"

# 上游 provider 列表。每个 provider 的 keys 是主备序列(索引在前者优先)。
# type 仅支持 openai / anthropic。
providers:
  - name: openai
    base_url: "https://api.openai.com/v1"
    type: openai
    keys:
      - "sk-openai-primary"
      - "sk-openai-backup"

  - name: deepseek
    base_url: "https://api.deepseek.com/v1"
    type: openai          # DeepSeek 原生 OpenAI 兼容
    keys:
      - "sk-deepseek-1"

  - name: anthropic
    base_url: "https://api.anthropic.com"
    type: anthropic
    keys:
      - "sk-ant-primary"
      - "sk-ant-backup"

# model -> provider 路由表。请求的 model 字段命中这里,走对应 provider。
# 每个 model 可对应多个 provider，按顺序 fallback（先换 key，同 provider 的 key 耗尽后再换 provider）。
routes:
  "gpt-4o":
    - openai
  "gpt-4o-mini":
    - openai
  "deepseek-chat":
    - deepseek
  "claude-sonnet-4-5":
    - anthropic
  "claude-opus-4-1":
    - anthropic